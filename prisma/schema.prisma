datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int           @id @default(autoincrement())
  email        String?       @unique @db.Citext
  login        String        @unique
  password     String
  refreshToken String?
  role         String        @default("USER") 
  isEmailVerified Boolean    @default(false)
  emailVerificationToken String?
  emailVerificationExpires DateTime?
  passwordResetToken String?
  passwordResetExpires DateTime?
  passwordResetCode String?
  passwordResetCodeExpires DateTime?
  books        Book[]
  collections  Collection[]
  progress     ReadingProgress[]
  bookmarks    Bookmark[]
  notes        Note[]
  ratings      Rating[]
  viewHistory  ViewHistory[]
}

model Book {
  id               Int             @id @default(autoincrement())
  title            String
  author           String?
  format           String
  publisher        String?
  language         String?
  storagePath      String?         @unique
  filePath         String          @unique
  originalFilePath String?
  genre            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  isPublic         Boolean         @default(false)
  imageUrl         String?
  avgRating        Float?          @default(0.0)
  externalId       String?         // ID from external source (Google Books, Open Library, etc.)
  externalSource   String?         // Source name: google_books, open_library, project_gutenberg, internet_archive
  isbn             String?         // ISBN for better book identification
  pageCount        Int?            // Number of pages
  description      String?         // Book description
  publishedDate    String?         // Publication date
  lastSyncedAt     DateTime?       // Last time metadata was synced with external source
  
  tags             Tag[]           @relation("BookToTags")
  collections      Collection[]
  bookmarks        Bookmark[]
  notes            Note[]
  progress         ReadingProgress[]
  ratings          Rating[]
  viewHistory      ViewHistory[]
  user             User?           @relation(fields: [userId], references: [id])
  userId           Int?
}

model Tag {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  books Book[]  @relation("BookToTags")
}

model ReadingProgress {
  id        Int      @id @default(autoincrement())
  progress  Float
  position  String
  updatedAt DateTime @default(now())
  
  book      Book     @relation(fields: [bookId], references: [id])
  bookId    Int
  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  @@unique([bookId, userId])
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  position  String
  note      String?
  createdAt DateTime @default(now())
  
  book      Book     @relation(fields: [bookId], references: [id])
  bookId    Int
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
}

model Note {
  id        Int      @id @default(autoincrement())
  content   String
  position  String
  createdAt DateTime @default(now())
  
  book      Book     @relation(fields: [bookId], references: [id])
  bookId    Int
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
}

model Collection {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  
  books     Book[]
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?
}

model Rating {
  id        Int      @id @default(autoincrement())
  value     Float    @default(0.0)
  createdAt DateTime @default(now())
  
  book      Book     @relation(fields: [bookId], references: [id])
  bookId    Int
  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  @@unique([bookId, userId])
}

model ViewHistory {
  id        Int      @id @default(autoincrement())
  viewedAt  DateTime @default(now())
  
  book      Book     @relation(fields: [bookId], references: [id])
  bookId    Int
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
}

model ExternalSource {
  id          Int      @id @default(autoincrement())
  name        String   @unique  // google_books, open_library, project_gutenberg, internet_archive
  displayName String   // Human readable name
  apiKey      String?  // API key if required
  isEnabled   Boolean  @default(true)
  lastSyncAt  DateTime?
  syncCount   Int      @default(0)
  errorCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SyncLog {
  id          Int      @id @default(autoincrement())
  source      String   // Source name
  operation   String   // search, import, enhance, trending
  query       String?  // Search query used
  resultCount Int      @default(0)
  successCount Int     @default(0)
  errorCount  Int      @default(0)
  duration    Int?     // Duration in milliseconds
  status      String   // success, partial, failed
  errorMessage String? // Error details if failed
  createdAt   DateTime @default(now())
}